{
  "name": "vue3-survey-builder",
  "version": "3.1.0",
  "main": "./dist/form-builder.umd.js",
  "module": "./dist/form-builder.mjs",
  "types": "./dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaeedP11/vue-survey-builder.git"
  },
  "bugs": {
    "url": "https://github.com/SaeedP11/vue-survey-builder/issues"
  },
  "homepage": "https://github.com/SaeedP11/vue-survey-builder#readme",
  "exports": {
    ".": {
      "import": "./dist/form-builder.mjs",
      "require": "./dist/form-builder.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/form-builder.css",
    "./tailwind.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && npm run build:types",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && vitest run --config vitest.package.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run test:package",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "survey-core": "^2.5.18",
    "survey-creator-core": "^2.5.18",
    "survey-creator-vue": "^2.5.18",
    "survey-vue3-ui": "^2.5.18",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.0.0"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "csv-parser": "^3.2.1",
    "jsdom": "^30.1.1",
    "survey-core": "^2.5.18",
    "survey-creator-core": "^2.5.18",
    "survey-creator-vue": "^2.5.18",
    "survey-vue3-ui": "^2.5.18",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^5.0.2",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.6",
    "vue-tsc": "^3.2.5"
  }
}
